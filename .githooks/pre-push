#!/usr/bin/env bash
# Refuse to push to GitHub (public) any commit containing a private path: docs/,
# AGENTS.md, CLAUDE.md. They live only on the private Gitea remote; GitHub is fed
# by scripts/publish-github.sh, which strips them. Enabled with: git config core.hooksPath .githooks
remote_url=$2
case "$remote_url" in *github.com*) ;; *) exit 0 ;; esac

PRIVATE_PATHS='docs AGENTS.md CLAUDE.md' # keep in step with scripts/publish-github.sh
zero=0000000000000000000000000000000000000000
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue # branch deletion
  if [ "$rsha" = "$zero" ]; then range=$lsha; else range="$rsha..$lsha"; fi
  for c in $(git rev-list "$range" 2>/dev/null || git rev-list "$lsha"); do
    # shellcheck disable=SC2086
    hit=$(git ls-tree --name-only "$c" -- $PRIVATE_PATHS | head -1)
    if [ -n "$hit" ]; then
      echo "✗ pre-push: commit ${c:0:7} contains $hit, which must not go to GitHub." >&2
      echo "  Publish with scripts/publish-github.sh instead." >&2
      exit 1
    fi
  done
done
exit 0
